# 값은 저장소에 넣지 말 것. 실제 값은 배포 환경 변수로.
KAKAO_REST_KEY=
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
# 안경 WebSocket 인증용. 예: openssl rand -hex 16
GLASS_TOKEN=
PORT=8787
# 폰(단축어, Overland)용 API 토큰. 비우면 /location 등 HTTP API 꺼짐
API_TOKEN=
# 단축어로 시작·재탐색했을 때 알림 받을 Slack 사용자 ID (선택)
SLACK_NOTIFY_USER=
# 실시간 도착 (없으면 꺼짐). 지하철: data.seoul.go.kr, 버스: data.go.kr
SEOUL_SUBWAY_KEY=
DATA_GO_KR_KEY=
REALTIME_POLL_MS=20000
